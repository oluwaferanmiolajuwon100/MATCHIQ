
import streamlit as st
import pandas as pd
import os

st.set_page_config(
    page_title="MATCHIQ",
    page_icon="⚽",
    layout="wide"
)

st.title("⚽ MATCHIQ")
st.subheader("Football Intelligence & Statistical Prediction Platform")

def load_data(filename):
    if os.path.exists(filename):
        return pd.read_csv(filename)
    return pd.DataFrame()

predictions = load_data("MATCHIQ_Final_V3_Predictions.csv")
history = load_data("MATCHIQ_Historical_Database.csv")
fixtures = load_data("MATCHIQ_Upcoming_Fixtures.csv")

page = st.sidebar.radio(
    "Navigation",
    ["Overview", "Historical Predictions", "Upcoming Fixtures"]
)

if page == "Overview":
    st.header("MATCHIQ Overview")
    a, b, c = st.columns(3)
    a.metric("Historical Matches", len(history))
    b.metric("Historical Predictions", len(predictions))
    c.metric("Upcoming Fixtures", len(fixtures))

    st.subheader("Poisson V3 Performance")
    st.write("Historical accuracy: 45.34%")
    st.write("Chronological holdout accuracy: 51.01%")
    st.info("Historical results do not guarantee future performance.")

elif page == "Historical Predictions":
    st.header("Historical Predictions")
    st.dataframe(predictions, use_container_width=True)

elif page == "Upcoming Fixtures":
    st.header("Upcoming Fixtures")
    st.warning(
        "Current team data is unavailable. "
        "No predictions have been generated."
    )
    st.dataframe(fixtures, use_container_width=True)

